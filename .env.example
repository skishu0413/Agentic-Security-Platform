# Agentic Security Platform Configuration
# Copy this file to '.env' in the same directory and fill in your API keys

# OpenAI API credentials
OPENAI_API_KEY=

# Anthropic Claude API credentials
ANTHROPIC_API_KEY=

# Ollama local environment configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional custom Cursor key (falls back to OpenAI if blank)
CURSOR_API_KEY=
